# Copy into backend/.env; never put database credentials in frontend variables.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional direct connection for migration/import commands. Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
# Set to production when serving over HTTPS.
ENV=development
